; Engine configuration file.
; picosim — Godot front end for the multi-cycle ARMv6-M teaching simulator.

config_version=5

[application]

config/name="picosim"
config/description="Multi-cycle ARMv6-M teaching simulator"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Palette="*res://scripts/palette.gd"
Backend="*res://scripts/backend.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=960
window/energy_saving/keep_screen_on=false

[gui]

theme/default_font_antialiasing=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
